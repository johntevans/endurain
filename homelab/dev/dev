#!/usr/bin/env bash
# Homelab fork: drive the dev stack (homelab/dev/compose.yml).
#
#   dev seed [--fresh]  copy production into the dev stack (read-only on macmini)
#   dev up              start it; builds the image and seeds on first run
#   dev down            stop it (data kept)
#   dev rebuild         rebuild endurain-dev:local (backend deps or baked frontend changed)
#   dev logs [svc]      follow logs (backend, frontend, postgres, redis)
#   dev psql            psql into the dev database
#   dev status          containers and URLs
#   dev reset           stop and DELETE the dev database, node_modules and data
#
# Seeding takes last night's pg_dump from macmini (kopia-hot/endurain.dump),
# or with --fresh a new pg_dump of the live DB, plus an rsync of its data dir.
# Neither writes anything on macmini. The copy then has every Garmin and
# Strava token removed BEFORE the backend starts, because the backend pulls
# Garmin on startup and hourly: a dev copy must never log in to Garmin as you
# (two sessions from one IP is what earned the 429s on 2026-10-13). Its
# FERNET_KEY is also different from production's, so the tokens could not be
# decrypted anyway.
set -euo pipefail

export PATH=/usr/local/bin:/opt/homebrew/bin:$PATH

HERE=$(cd "$(dirname "$0")" && pwd)
export ENDURAIN_DEV_ROOT=${ENDURAIN_DEV_ROOT:-$HOME/.local/share/endurain-dev}
export ENDURAIN_DEV_URL=${ENDURAIN_DEV_URL:-http://$(scutil --get LocalHostName 2>/dev/null || hostname -s).local:5173}
PROD_HOST=${ENDURAIN_PROD_HOST:-macmini}
PROD_DIR=${ENDURAIN_PROD_DIR:-Server/endurain}

dc() { docker compose -f "$HERE/compose.yml" "$@"; }
log() { printf '==> %s\n' "$*"; }
die() { printf 'dev: %s\n' "$*" >&2; exit 1; }

ensure_docker() {
    docker info >/dev/null 2>&1 && return
    command -v orb >/dev/null || die "docker is not running and OrbStack is not installed"
    log "starting OrbStack"
    orb start >/dev/null 2>&1 || true
    for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && return; sleep 2; done
    die "docker did not come up"
}

ensure_env() {
    mkdir -p "$ENDURAIN_DEV_ROOT/data" "$ENDURAIN_DEV_ROOT/logs"
    [[ -f $ENDURAIN_DEV_ROOT/.env ]] && return
    log "generating dev secrets in $ENDURAIN_DEV_ROOT/.env"
    local pw; pw=$(openssl rand -hex 24)
    umask 077
    cat > "$ENDURAIN_DEV_ROOT/.env" <<EOF
# Dev-only secrets, generated by homelab/dev/dev. Deliberately NOT production's.
DB_PASSWORD=$pw
POSTGRES_PASSWORD=$pw
POSTGRES_DB=endurain
POSTGRES_USER=endurain
SECRET_KEY=$(openssl rand -hex 32)
FERNET_KEY=$(openssl rand -base64 32 | tr '+/' '-_')
EOF
}

ensure_image() {
    docker image inspect endurain-dev:local >/dev/null 2>&1 && return
    log "building endurain-dev:local (first run takes a few minutes)"
    dc build backend
}

wait_postgres() {
    dc up -d --wait postgres >/dev/null
}

psql_q() { dc exec -T postgres psql -U endurain -d endurain -v ON_ERROR_STOP=1 -Atc "$1"; }

is_seeded() {
    wait_postgres
    [[ $(psql_q "select to_regclass('public.activities') is not null" 2>/dev/null) == t ]]
}

cmd_seed() {
    local fresh=0
    [[ ${1:-} == --fresh ]] && fresh=1
    ensure_docker; ensure_env
    local dump=$ENDURAIN_DEV_ROOT/endurain.dump

    if (( fresh )); then
        log "taking a fresh pg_dump of production on $PROD_HOST (read-only)"
        ssh "$PROD_HOST" 'export PATH=/usr/local/bin:/opt/homebrew/bin:$PATH; docker exec endurain-postgres pg_dump -U endurain -Fc endurain' > "$dump.tmp"
    else
        log "copying last night's dump from $PROD_HOST:$PROD_DIR/kopia-hot/endurain.dump"
        scp -q "$PROD_HOST:$PROD_DIR/kopia-hot/endurain.dump" "$dump.tmp"
    fi
    [[ -s $dump.tmp ]] || die "empty dump"
    mv "$dump.tmp" "$dump"

    log "syncing photos, thumbnails and activity files"
    rsync -a --delete "$PROD_HOST:$PROD_DIR/backend/data/" "$ENDURAIN_DEV_ROOT/data/"

    log "restoring into the dev database"
    dc stop backend frontend >/dev/null 2>&1 || true
    wait_postgres
    dc exec -T postgres sh -c 'dropdb -U endurain --if-exists --force endurain && createdb -U endurain endurain'
    dc exec -T postgres pg_restore -U endurain -d endurain --no-owner --no-acl < "$dump"

    log "removing Garmin and Strava tokens from the copy"
    psql_q "update users_integrations set garminconnect_token = null, strava_token = null,
              strava_refresh_token = null, strava_token_expires_at = null" >/dev/null
    local left
    left=$(psql_q "select count(*) from users_integrations where garminconnect_token is not null or strava_token is not null or strava_refresh_token is not null")
    [[ $left == 0 ]] || die "$left integration tokens survived the scrub; NOT starting the backend"

    log "seeded: $(psql_q 'select count(*) from activities') activities, alembic $(psql_q 'select version_num from alembic_version')"
}

cmd_up() {
    ensure_docker; ensure_env; ensure_image
    is_seeded || cmd_seed
    # Re-check on every start, in case anything wrote a token since.
    local left
    left=$(psql_q "select count(*) from users_integrations where garminconnect_token is not null or strava_token is not null or strava_refresh_token is not null")
    [[ $left == 0 ]] || die "the dev DB holds $left Garmin/Strava tokens; run 'dev seed' (it scrubs them) before starting"
    dc up -d
    cmd_status
}

cmd_status() {
    dc ps --format 'table {{.Name}}\t{{.Status}}'
    cat <<EOF

  app (live frontend):          $ENDURAIN_DEV_URL
  backend + baked frontend:     ${ENDURAIN_DEV_URL%:5173}:8092
  API docs:                     ${ENDURAIN_DEV_URL%:5173}:8092/docs
  log in with your production username and password (the DB is a copy).
EOF
}

case ${1:-} in
    seed)    shift; cmd_seed "$@"; dc up -d >/dev/null; cmd_status ;;
    up)      cmd_up ;;
    down)    ensure_docker; dc down ;;
    rebuild) ensure_docker; ensure_env; dc build backend; dc up -d backend ;;
    logs)    shift; dc logs -f --tail 100 "$@" ;;
    psql)    dc exec postgres psql -U endurain -d endurain ;;
    status)  cmd_status ;;
    reset)
        read -r -p "Delete the dev database, node_modules and $ENDURAIN_DEV_ROOT? [y/N] " a
        [[ $a == y ]] || exit 1
        dc down -v; rm -rf "$ENDURAIN_DEV_ROOT" ;;
    *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
